<Project Sdk="Microsoft.NET.Sdk">
  <!-- Eklentinin okuyucu kodunu (PressReader) UI dökümleri üzerinde oyunsuz çalıştırır. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 27</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\plugin\FM27PressVoice\Ui.cs" Link="Plugin\Ui.cs" />
    <Compile Include="..\..\plugin\FM27PressVoice\PressState.cs" Link="Plugin\PressState.cs" />
    <Compile Include="..\..\plugin\FM27PressVoice\PressReader.cs" Link="Plugin\PressReader.cs" />
  </ItemGroup>
  <ItemGroup>
    <Ref Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll;$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll;$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll;$(GameDir)\BepInEx\interop\UnityEngine.UIElementsModule.dll;$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll;$(GameDir)\BepInEx\interop\SI.Bindable.dll" />
    <Reference Include="@(Ref)" Private="true" />
  </ItemGroup>
</Project>
