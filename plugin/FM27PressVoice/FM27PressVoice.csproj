<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FM27PressVoice</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Kendi yoluna göre değiştir:  dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\Football Manager 27" -->
    <GameDir Condition="'$(GameDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 27</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Oyunda kurulu BepInEx (6.0.0-be.793) çekirdek derlemeleri: NuGet yerine birebir aynı sürüm -->
    <CoreDlls Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll;
                       $(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll;
                       $(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll;
                       $(GameDir)\BepInEx\core\Il2CppInterop.Common.dll;
                       $(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll;
                       $(GameDir)\BepInEx\core\0Harmony.dll" />
    <Reference Include="@(CoreDlls)" Private="false" />
    <!-- BepInEx'in ürettiği interop derlemelerinin hepsi (Il2Cppmscorlib, UnityEngine.*, oyunun kendi tipleri) -->
    <InteropDlls Include="$(GameDir)\BepInEx\interop\*.dll" />
    <Reference Include="@(InteropDlls)" Private="false" />
  </ItemGroup>
</Project>
